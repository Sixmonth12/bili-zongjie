{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bili-zongjie",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bili-study",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "cloudflare/migrations"
  }],
  "vars": {
    "STUDY_ALLOWED_PROVIDERS": "https://api.openai.com/v1,https://api.deepseek.com,https://dashscope.aliyuncs.com/compatible-mode/v1"
  },
  "observability": { "enabled": false }
}
